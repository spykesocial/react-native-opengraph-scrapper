{
  "name": "@spykesocial/react-native-opengraph-scrapper",
  "description": "React Native scraper module for Open Graph and Twitter Card info",
  "version": "1.2.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && tsx scripts/write-cjs-wrapper.ts",
    "eslint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" --fix",
    "eslint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.tests.json",
    "mocha:unit": "npm run build && c8 --reporter=html --reporter=text mocha --import=tsx --require ./tests/helpers/bootstrap.ts --recursive \"./tests/unit/**/*.spec.ts\"",
    "mocha:int": "npm run build && mocha --import=tsx --require ./tests/helpers/bootstrap.ts --recursive \"./tests/integration/**/*.spec.ts\" --timeout 10000",
    "mocha:rn": "npm run build && mocha --import=tsx --require ./tests/helpers/bootstrap.ts --recursive \"./tests/react-native/**/*.spec.ts\" --timeout 15000",
    "test": "npm run mocha:unit && npm run mocha:int && npm run mocha:rn"
  },
  "engines": {
    "node": ">=18.x"
  },
  "peerDependencies": {
    "react-native": ">=0.70.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "dependencies": {
    "chardet": "^2.2.0",
    "cheerio": "^1.2.0",
    "validator": "^13.15.35"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^22.0.0",
    "@types/validator": "^13.15.10",
    "@typescript/native": "npm:typescript@^7.0.2",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.8.0",
    "eslint-plugin-mocha": "^12.0.1",
    "globals": "^17.8.0",
    "mocha": "^11.7.6",
    "react": "^19.2.8",
    "react-native": "0.86.2",
    "sinon": "^22.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "whatwg-fetch": "^3.6.20"
  },
  "resolutions": {
    "diff": "^9.0.0",
    "esbuild": "^0.28.1",
    "js-yaml": "^5.4.1",
    "serialize-javascript": "^7.0.7",
    "shell-quote": "^1.10.0",
    "undici": "^7.29.1",
    "minimatch": "10.2.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/spykesocial/react-native-opengraph-scrapper.git",
    "web": "https://github.com/spykesocial/react-native-opengraph-scrapper"
  },
  "keywords": [
    "app links",
    "dublin core",
    "meta tags",
    "metadata",
    "og",
    "ogp",
    "open graph",
    "opengraph",
    "scraper",
    "twitter card",
    "twitter"
  ]
}
